@{
}
@model Employees
<h1>Add New Employe</h1>

<form asp-controller="Dashboard" asp-action="Create" method="post">

    <div class="mb-3">
        <label asp-for="Name" class="form-label">    </label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label"> </label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Role"></label>
        <select asp-for="Role" class="form-control">
            <option> Web Designer</option>
            <option> Web Developer</option>
            <option>Video Editer</option>
            <option>UI/UX Designer</option>
        </select>
    </div>
   
    <div class="mb-3">
        <label asp-for="Department"></label>
        <select asp-for="Department" class="form-control">
            <option> Designeing</option>
            <option> Developments</option>
            <option>Video Editing</option>
            
        </select>
    </div>
    <button type="submit" class="btn btn-success">Save</button>

    <a class="btn btn-secondary" asp-area="" asp-controller="Dashboard" asp-action="Employees">Cancel</a>


</form>
