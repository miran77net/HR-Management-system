@model List<Employees>;
        
<h3 class="mb-3">Employees</h3>
@{
    var userRole = Context.Session.GetString("UserRole");
    var userEmail = Context.Session.GetString("UserEmail");

    if (userRole == "HRSir")
    {
        
        <p>All the employees of the company are listed here</p>

        <form asp-action="Index" method="get" class="mb-3">
            <div class="input-group">

                <input type="text" id="searchInput" placeholder="Search..." class="form-control mb-3" />
            </div>
        </form>

        <p>
            <a asp-action="Create" class="btn btn-success">+ Create New Employee</a>
        </p>
    }
}


<table id="dataTable" class="table table-striped table-hover">
    <thead class="table-dark text-center">
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Email</th>
            <th>Role</th>
            <th>Department</th>
            <th>Joining Date</th>
            <th>Actions</th>
            
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@item.Email</td>
                <td>@item.Role</td>
                <td> @item.Department</td>
               
                <td>@item.Joiningdate.ToString("dd-MMM-yyyy")</td>
                <td>
                   
                    <a asp-action="Edit"
                           asp-route-id="@item.Id"
                           class="btn btn-warning btn-sm">
                        Edit
                    </a>

                    <a asp-action="Delete"
                           asp-route-id="@item.Id"
                           class="btn btn-danger btn-sm">
                        Delete
                    </a>
                </td>
            </tr>
        }
                        
                            }

                               @{
                                    @foreach (var item in Model)
        {
                                 if (userRole == "Employe")
                                {
                    
                                if (userEmail == item.Email)
                                {
                                    <tr>
                                       <td>@item.Id</td>
                                        <td>@item.Name </td>
                                        <td>@item.Email</td>
                                        <td>@item.Role </td>
                                         <td>@item.Department</td>
                                         <td>@item.Joiningdate</td>
                                      
                                    </tr>
                                }
                                }
                            

                                }
 

                
            }

        }
    </tbody>
</table>

<script src="~/js/site.js" asp-append-version="true"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>